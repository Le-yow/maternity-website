@model MaterniTrack.Models.ViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    ViewData["BodyClass"] = "settings-page";
    ViewData["ActiveSettingsTab"] = "Users";
}

@section Styles {
  <link rel="stylesheet" href="~/css/settings-users.css">
}

<main class="settings-layout">
  <partial name="_SettingsSidebar" />

  <section class="settings-main" aria-label="User management">
    <header class="settings-header">
      <div>
        <h1 class="settings-title">User Management</h1>
        <p class="settings-subtitle">Manage authorized staff accounts. Admin access only.</p>
      </div>
      <button type="button" class="btn-primary" onclick="openAddModal()">Add Staff Account</button>
    </header>

    @if (ViewBag.SuccessMessage != null)
    {
      <div style="background:#d1fae5;border-left:4px solid #10b981;color:#065f46;padding:12px 16px;border-radius:6px;margin-bottom:16px;font-size:14px;font-weight:500;">
        <i class="bi bi-check-circle-fill"></i> @ViewBag.SuccessMessage
      </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
      <div style="background:#fee2e2;border-left:4px solid #ef4444;color:#991b1b;padding:12px 16px;border-radius:6px;margin-bottom:16px;font-size:14px;font-weight:500;">
        <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
      </div>
    }

    <div class="admin-warning" role="note" aria-label="Admin access notice">
      <div class="admin-warning-icon" aria-hidden="true">
        <i class="bi bi-exclamation-triangle-fill"></i>
      </div>
      <p class="admin-warning-text">
        Admin Access Only. Only the clinic administrator can add, edit, or remove staff accounts. Staff members not registered here will be denied access to the system.
      </p>
    </div>

    <section class="stats-row" aria-label="Staff account stats">
      <article class="stat-card">
        <span class="stat-icon stat-icon--green" aria-hidden="true"><i class="bi bi-person-check-fill"></i></span>
        <p class="stat-number">@Model.TotalUsersCount</p>
        <p class="stat-label">Total staff accounts</p>
      </article>

      <article class="stat-card">
        <span class="stat-icon stat-icon--amber" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
        <p class="stat-number">@Model.AdminUsersCount</p>
        <p class="stat-label">Doctor / Admin accounts</p>
      </article>

      <article class="stat-card">
        <span class="stat-icon stat-icon--blue" aria-hidden="true"><i class="bi bi-clipboard2-check-fill"></i></span>
        <p class="stat-number">@Model.StaffUsersCount</p>
        <p class="stat-label">Staff accounts</p>
      </article>
    </section>

    <!-- Filter Bar -->
    <form method="get" asp-action="Users" id="filterForm">
      <section class="search-filters" aria-label="Search and filter staff">
        <div class="search-field">
          <label class="filter-label" for="staffSearchInput">Search staff</label>
          <div class="search-input-wrapper">
            <span class="search-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
            <input
              id="staffSearchInput"
              name="search"
              class="search-input"
              type="text"
              placeholder="Search staff by name or email..."
              value="@Model.CurrentSearch"
              onchange="this.form.submit()"
            >
          </div>
        </div>

        <div class="filter-field">
          <label class="filter-label" for="filterRole">Role filter</label>
          <select id="filterRole" name="role" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(Model.CurrentRole == "all")">All Roles</option>
            <option value="Doctor" selected="@(Model.CurrentRole == "Doctor")">Doctor (Admin)</option>
            <option value="Staff" selected="@(Model.CurrentRole == "Staff")">Staff</option>
          </select>
        </div>

        <div class="filter-field">
          <label class="filter-label" for="filterStatus">Status filter</label>
          <select id="filterStatus" name="status" class="filter-select" onchange="this.form.submit()">
            <option value="all" selected="@(Model.CurrentStatus == "all")">All Status</option>
            <option value="Active" selected="@(Model.CurrentStatus == "Active")">Active</option>
            <option value="Inactive" selected="@(Model.CurrentStatus == "Inactive")">Inactive</option>
          </select>
        </div>
      </section>
    </form>

    <div class="table-wrap" aria-label="Staff table">
      <table class="staff-table">
        <thead>
          <tr>
            <th>Staff Name</th>
            <th>Email Address</th>
            <th>Role</th>
            <th>Status</th>
            <th style="width: 150px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (!Model.Users.Any())
          {
            <tr>
              <td colspan="5" style="text-align:center;padding:30px;color:#888;">
                No staff accounts found matching your filter criteria.
              </td>
            </tr>
          }
          else
          {
            @foreach (var user in Model.Users)
            {
              var isDoctor = user.Role.Equals("Doctor", StringComparison.OrdinalIgnoreCase);
              var isActive = user.Status.Equals("Active", StringComparison.OrdinalIgnoreCase);

              <tr>
                <td><strong>@user.FullName</strong></td>
                <td>@user.Email</td>
                <td>
                  <span class="role-badge @(isDoctor ? "role-badge-admin" : "role-badge-staff")">
                    @(isDoctor ? "DOCTOR / ADMIN" : "STAFF")
                  </span>
                </td>
                <td>
                  <span class="status-badge @(isActive ? "badge-good" : "badge-out-of-stock")">
                    @user.Status
                  </span>
                </td>
                <td>
                  <div style="display:flex;gap:6px;">
                    <button type="button" class="btn-action" style="background:#f0faf6;border:1px solid #b8d8c8;color:#2d604d;padding:4px 8px;border-radius:4px;cursor:pointer;"
                            onclick="openEditModal('@user.Id', '@user.FullName.Replace("'", "\\'")' , '@user.Email.Replace("'", "\\'")' , '@user.Role', '@user.Status')">
                      <i class="bi bi-pencil"></i> Edit
                    </button>
                    <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to remove @user.FullName?');" style="display:inline;">
                      @Html.AntiForgeryToken()
                      <input type="hidden" name="id" value="@user.Id" />
                      <button type="submit" class="btn-action" style="background:#fff8f8;border:1px solid #f2c6c6;color:#b82a2a;padding:4px 8px;border-radius:4px;cursor:pointer;">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>

    <p class="settings-bottom-note">
      Once added, this staff member can immediately log in using their registered account credentials.
    </p>
  </section>
</main>

<!-- Add Staff Modal -->
<div id="addStaffModal" class="modal-overlay is-hidden" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-header">
      <div>
        <h2 class="modal-title">Add New Staff Account</h2>
        <p class="modal-subtitle">Enter the staff member's details and assign credentials.</p>
      </div>
      <button type="button" class="modal-close" onclick="closeAddModal()"><i class="bi bi-x"></i></button>
    </div>
    <form asp-action="CreateUser" method="post" class="modal-body">
      @Html.AntiForgeryToken()
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Full Name *</label>
          <input name="FullName" class="field-input" type="text" placeholder="e.g. Maria Santos" required />
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Email Address *</label>
          <input name="Email" class="field-input" type="email" placeholder="e.g. maria@clinic.local" required />
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Assign Role *</label>
          <select name="Role" class="field-input" required>
            <option value="Staff">Staff — Can manage appointments, patients, and inventory</option>
            <option value="Doctor">Doctor (Admin) — Full access including user management</option>
          </select>
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Status *</label>
          <select name="Status" class="field-input" required>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
          </select>
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Password *</label>
          <input name="Password" class="field-input" type="password" placeholder="At least 6 characters" minlength="6" required />
        </div>
      </div>
      <div class="modal-footer" style="padding-top:16px;">
        <button type="button" class="btn-cancel" onclick="closeAddModal()">Cancel</button>
        <button type="submit" class="btn-primary">Add Staff Account</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Staff Modal -->
<div id="editStaffModal" class="modal-overlay is-hidden" role="dialog" aria-modal="true">
  <div class="modal-card">
    <div class="modal-header">
      <div>
        <h2 class="modal-title">Edit Staff Account</h2>
        <p class="modal-subtitle">Update details for this staff member.</p>
      </div>
      <button type="button" class="modal-close" onclick="closeEditModal()"><i class="bi bi-x"></i></button>
    </div>
    <form asp-action="EditUser" method="post" class="modal-body">
      @Html.AntiForgeryToken()
      <input type="hidden" name="Id" id="editUserId" />
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Full Name *</label>
          <input name="FullName" id="editFullName" class="field-input" type="text" required />
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Email Address *</label>
          <input name="Email" id="editEmail" class="field-input" type="email" required />
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Assign Role *</label>
          <select name="Role" id="editRole" class="field-input" required>
            <option value="Staff">Staff</option>
            <option value="Doctor">Doctor (Admin)</option>
          </select>
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Status *</label>
          <select name="Status" id="editStatus" class="field-input" required>
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
          </select>
        </div>
      </div>
      <div class="modal-row">
        <div class="form-field">
          <label class="field-label">Change Password (Leave blank to keep current)</label>
          <input name="NewPassword" class="field-input" type="password" placeholder="New password (optional)" />
        </div>
      </div>
      <div class="modal-footer" style="padding-top:16px;">
        <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancel</button>
        <button type="submit" class="btn-primary">Save Changes</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script>
  function openAddModal() {
    document.getElementById('addStaffModal').classList.remove('is-hidden');
  }
  function closeAddModal() {
    document.getElementById('addStaffModal').classList.add('is-hidden');
  }

  function openEditModal(id, name, email, role, status) {
    document.getElementById('editUserId').value = id;
    document.getElementById('editFullName').value = name;
    document.getElementById('editEmail').value = email;
    document.getElementById('editRole').value = role;
    document.getElementById('editStatus').value = status;
    document.getElementById('editStaffModal').classList.remove('is-hidden');
  }
  function closeEditModal() {
    document.getElementById('editStaffModal').classList.add('is-hidden');
  }

  ['addStaffModal', 'editStaffModal'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', function(e) {
      if (e.target === this) this.classList.add('is-hidden');
    });
  });
</script>
}
